# Copy to .env (or set real environment variables). All values are optional.
PORT=8080
HOST=0.0.0.0
NODE_ENV=production

# Behind nginx / a load balancer / Cloudflare? Set true so client IPs and HTTPS are read from X-Forwarded-* headers.
TRUST_PROXY=false

# CORS: empty = same-origin only; * = any origin (read-only API); or comma-separated origins.
CORS_ORIGINS=

# Rate limit (requests per minute per client IP) for /api and /oai; the dataset download has its own lower limit.
RATE_LIMIT_PER_MIN=300
DATASET_RATE_LIMIT_PER_MIN=30

# Secret for /api/admin/* and /metrics. Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=

# Optional anonymous usage telemetry written to logs/telemetry-YYYY-MM-DD.jsonl (no IP addresses stored).
TELEMETRY=false
# Also store query text in telemetry? Leave false unless you have a privacy notice / consent.
TELEMETRY_QUERIES=false

# OAI-PMH identity
OAI_NAMESPACE=lis-kg-explorer.example.org
OAI_REPOSITORY_NAME=LIS Knowledge Graph Explorer
OAI_ADMIN_EMAIL=admin@example.org

# Graph database proxies (credentials stay on the server). Disabled unless PROXY_ENABLED=true and a URL is set.
PROXY_ENABLED=false
NEO4J_URL=http://localhost:7474
NEO4J_DB=neo4j
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_ALLOW_WRITE=false
GRAPHDB_URL=http://localhost:7200/repositories/library
GRAPHDB_USER=
GRAPHDB_PASSWORD=

# Paths (relative to the project root)
DATA_FILE=data/dataset.json.gz
PUBLIC_DIR=public
LOG_DIR=logs
BACKUP_DIR=backups
BACKUP_KEEP=14
